{
  "name": "dsh-cron-guard",
  "version": "0.1.0",
  "author": "monkey-sking",
  "type": "module",
  "description": "Govern DSH scheduled wake-ups: let them cut into the running turn instead of waiting for it, drop stale occurrences, coalesce duplicates, and time out abandoned approval prompts.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "schedule",
    "cron",
    "inbox",
    "head-of-line",
    "approval"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.mjs\""
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monkey-sking/dsh-cron-guard.git"
  },
  "homepage": "https://github.com/monkey-sking/dsh-cron-guard#readme",
  "bugs": {
    "url": "https://github.com/monkey-sking/dsh-cron-guard/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
